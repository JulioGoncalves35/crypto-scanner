# Required providers
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
CEREBRAS_API_KEY=your-cerebras-api-key-here   # cloud.cerebras.ai (free, ~14.4k TPM)
MISTRAL_API_KEY=your-mistral-api-key-here     # console.mistral.ai (free, ~1B tokens/mes)

# Backend
SCANNER_BACKEND_URL=http://localhost:3001

# Behavior
COUNCIL_DRY_RUN=true       # if true, never POSTs /api/trades/open
COUNCIL_MIN_SCORE=88       # candidate filter applied before invoking council (85 backend / 88 council)
COUNCIL_LOG_LEVEL=INFO
